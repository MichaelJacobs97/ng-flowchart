{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ngx-flowchart",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/lib",
      "output": "lib"
    },
    {
      "glob": "**/*.html",
      "input": "src/lib",
      "output": "src/lib"
    },
    {
      "glob": "**/*.ts",
      "input": "src/lib",
      "output": "src/lib"
    },
    {
      "glob": "public-api.ts",
      "input": "src",
      "output": "src"
    }
  ]
}